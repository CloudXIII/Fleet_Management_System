@inject IVehicleComponentService ComponentService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(EditingId is null ? "Add Component" : "Edit Component")</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_error</MudAlert>
        }
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_model.Name" For="@(() => _model.Name)"
                          Label="Name" Required="true" MaxLength="100" Class="mb-3" />
            <MudTextField @bind-Value="_model.SerialNumber" For="@(() => _model.SerialNumber)"
                          Label="Serial Number" MaxLength="50" Class="mb-3" />
            <MudDatePicker @bind-Date="_installationDate" Label="Installation Date" Required="true"
                           DateFormat="dd/MM/yyyy" Class="mb-3" />
            <div class="d-flex justify-end gap-2 mt-2">
                <MudButton OnClick="Cancel" ButtonType="ButtonType.Button">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit"
                           Disabled="_saving">Save</MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int VehicleId { get; set; }

    [Parameter]
    public int? EditingId { get; set; }

    [Parameter]
    public VehicleComponentWriteDto? InitialModel { get; set; }

    private VehicleComponentWriteDto _model = new();
    private DateTime? _installationDate = DateTime.Today;
    private bool _saving;
    private string? _error;

    protected override void OnInitialized()
    {
        if (InitialModel is not null)
        {
            _model = InitialModel;
            _installationDate = InitialModel.InstallationDate;
        }
        else
        {
            _model = new VehicleComponentWriteDto { VehicleId = VehicleId };
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_installationDate is null)
        {
            _error = "Installation date is required.";
            return;
        }

        _model.InstallationDate = _installationDate.Value;
        _model.VehicleId = VehicleId;
        _saving = true;
        _error = null;

        try
        {
            if (EditingId is int id)
                await ComponentService.UpdateComponentAsync(id, _model);
            else
                await ComponentService.CreateComponentAsync(_model);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
