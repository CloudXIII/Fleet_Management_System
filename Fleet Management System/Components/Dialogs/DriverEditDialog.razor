@inject IDriverService DriverService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(EditingId is null ? "Add Driver" : "Edit Driver")</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_error</MudAlert>
        }
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_model.Name" For="@(() => _model.Name)"
                          Label="Name" Required="true" MaxLength="100" Class="mb-3" />
            <MudTextField @bind-Value="_model.LicenseNumber" For="@(() => _model.LicenseNumber)"
                          Label="License Number" MaxLength="50" Class="mb-3" />
            <MudTextField @bind-Value="_model.Phone" For="@(() => _model.Phone)"
                          Label="Phone" MaxLength="30" Class="mb-3" />
            <div class="d-flex justify-end gap-2 mt-2">
                <MudButton OnClick="Cancel" ButtonType="ButtonType.Button">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit"
                           Disabled="_saving">Save</MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int? EditingId { get; set; }

    [Parameter]
    public DriverWriteDto? InitialModel { get; set; }

    private DriverWriteDto _model = new();
    private bool _saving;
    private string? _error;

    protected override void OnInitialized()
    {
        if (InitialModel is not null)
            _model = InitialModel;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_model.Phone))
                _model.Phone = null;
            if (string.IsNullOrWhiteSpace(_model.LicenseNumber))
                _model.LicenseNumber = null;

            if (EditingId is int id)
                await DriverService.UpdateDriverAsync(id, _model);
            else
                await DriverService.CreateDriverAsync(_model);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
