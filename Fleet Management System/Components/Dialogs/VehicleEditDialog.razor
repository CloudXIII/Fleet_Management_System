@inject IVehicleService VehicleService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(EditingId is null ? "Add Vehicle" : "Edit Vehicle")</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_error</MudAlert>
        }
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_model.Plate" For="@(() => _model.Plate)"
                          Label="Plate" Required="true" MaxLength="10" Class="mb-3" />
            <MudTextField @bind-Value="_model.Brand" For="@(() => _model.Brand)"
                          Label="Brand" Required="true" MaxLength="50" Class="mb-3" />
            <MudTextField @bind-Value="_model.Model" For="@(() => _model.Model)"
                          Label="Model" Required="true" MaxLength="50" Class="mb-3" />
            <MudDatePicker @bind-Date="_insuranceExpiry" Label="Insurance Expiry" Required="true"
                           DateFormat="dd/MM/yyyy" Class="mb-3" />
            <div class="d-flex justify-end gap-2 mt-2">
                <MudButton OnClick="Cancel" ButtonType="ButtonType.Button">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit"
                           Disabled="_saving">Save</MudButton>
            </div>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int? EditingId { get; set; }

    [Parameter]
    public VehicleWriteDto? InitialModel { get; set; }

    private VehicleWriteDto _model = new();
    private DateTime? _insuranceExpiry = DateTime.Today.AddYears(1);
    private bool _saving;
    private string? _error;

    protected override void OnInitialized()
    {
        if (InitialModel is not null)
        {
            _model = InitialModel;
            _insuranceExpiry = InitialModel.InsuranceExpiry;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_insuranceExpiry is null)
        {
            _error = "Insurance expiry is required.";
            return;
        }

        _model.InsuranceExpiry = _insuranceExpiry.Value;
        _saving = true;
        _error = null;

        try
        {
            if (EditingId is int id)
                await VehicleService.UpdateVehicleAsync(id, _model);
            else
                await VehicleService.CreateVehicleAsync(_model);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
