@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Dark">
        <MudLink Href="/vehicles" Typo="Typo.h6" Color="Color.Inherit" Underline="Underline.None" Class="me-6">
            Fleet Manager
        </MudLink>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/vehicles">
            Vehicles
        </MudButton>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 pb-16">
            @Body
        </MudContainer>
    </MudMainContent>

    <footer class="app-footer">
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            &copy; 2026 Fleet Manager — Built with ASP.NET Core Blazor &amp; MudBlazor — Alessandro Gallo
        </MudText>
    </footer>
</MudLayout>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1565C0",
            AppbarBackground = "#212121",
            Background = "#F5F5F5",
            Surface = "#FFFFFF"
        }
    };
}
