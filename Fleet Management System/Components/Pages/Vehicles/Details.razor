@page "/vehicles/{Id:int}"
@using Fleet_Management_System.Components.Dialogs
@using Fleet_Management_System.Components.Shared
@using Fleet_Management_System.Helpers
@inject IVehicleService VehicleService
@inject IVehicleComponentService ComponentService
@inject IDriverAssignmentService AssignmentService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Vehicle Details - Fleet Manager</PageTitle>

@if (_vehicle is null)
{
    if (_notFound)
    {
        <MudAlert Severity="Severity.Warning">Vehicle not found.</MudAlert>
        <MudButton Variant="Variant.Outlined" Href="/vehicles" Class="mt-3">Back to List</MudButton>
    }
    else
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack"
                       Href="/vehicles">
                Back to List
            </MudButton>
            <MudText Typo="Typo.h4">@_vehicle.Brand @_vehicle.Model</MudText>
            @if (_vehicle.HasActiveDriver)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success">Active driver</MudChip>
            }
            @if (_vehicle.IsInsuranceExpiringSoon)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Insurance expiring</MudChip>
            }
        </MudStack>
        <MudStack Row="true" Spacing="1">
            @if (_vehicle.HasActiveDriver)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.EventBusy" OnClick="EndActiveAssignmentAsync">
                    End current assignment
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Print"
                       Href="@($"/vehicles/{Id}/print")">
                Print sheet
            </MudButton>
        </MudStack>
    </MudStack>

    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-3"><b>General Information</b></MudText>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField Value="@_vehicle.Brand" Label="Brand" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Value="@_vehicle.Model" Label="Model" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Value="@_vehicle.Plate" Label="Plate" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Value="@_vehicle.InsuranceExpiry.ToString("dd/MM/yyyy")" Label="Insurance Expiry"
                              ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-2">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2">
            <MudTabPanel Text="Vehicle Components" Icon="@Icons.Material.Filled.Build">
                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateComponent">
                        Add
                    </MudButton>
                </MudStack>

                @if (!_loadingComponents && _components.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.Build"
                                Title="No components yet"
                                Message="Track engines, tyres, batteries and other parts installed on this vehicle."
                                ActionText="Add component"
                                OnAction="OpenCreateComponent" />
                }
                else
                {
                    <MudDataGrid T="VehicleComponentReadDto" Items="_components" Dense="true" Hover="true"
                                 Loading="_loadingComponents" Filterable="true">
                        <Columns>
                            <PropertyColumn Property="x => x.Name" Title="Name" />
                            <PropertyColumn Property="x => x.SerialNumber" Title="Serial Number" />
                            <PropertyColumn Property="x => x.InstallationDate" Title="Installation Date"
                                           Format="dd/MM/yyyy" />
                            <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
                                <CellTemplate>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => OpenEditComponent(context.Item))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => ConfirmDeleteComponentAsync(context.Item))" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                }
            </MudTabPanel>

            <MudTabPanel Text="Driver History" Icon="@Icons.Material.Filled.People">
                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-2" Spacing="1">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Download" OnClick="ExportAssignmentsCsvAsync"
                               Disabled="_assignments.Count == 0">
                        Export CSV
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAssignment">
                        Add
                    </MudButton>
                </MudStack>

                @if (!_loadingAssignments && _assignments.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Filled.People"
                                Title="No driver history yet"
                                Message="Assign a driver to start building the assignment timeline for this vehicle."
                                ActionText="Add assignment"
                                OnAction="OpenCreateAssignment" />
                }
                else
                {
                    <MudGrid>
                        <MudItem xs="12" md="5">
                            <MudText Typo="Typo.subtitle2" Class="mb-3">Timeline</MudText>
                            <MudTimeline TimelinePosition="TimelinePosition.Start">
                                @foreach (var item in _assignments)
                                {
                                    <MudTimelineItem Color="@(item.IsActive ? Color.Success : Color.Default)"
                                                     Variant="Variant.Filled"
                                                     Size="Size.Small">
                                        <ItemContent>
                                            <MudText Typo="Typo.subtitle2">@item.DriverName</MudText>
                                            <MudText Typo="Typo.caption">
                                                @item.StartDate.ToString("dd/MM/yyyy")
                                                –
                                                @(item.EndDate?.ToString("dd/MM/yyyy") ?? "present")
                                            </MudText>
                                            @if (item.IsActive)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="mt-1">Active</MudChip>
                                            }
                                        </ItemContent>
                                    </MudTimelineItem>
                                }
                            </MudTimeline>
                        </MudItem>
                        <MudItem xs="12" md="7">
                            <MudDataGrid T="DriverAssignmentReadDto" Items="_assignments" Dense="true" Hover="true"
                                         Loading="_loadingAssignments" Filterable="true">
                                <Columns>
                                    <PropertyColumn Property="x => x.DriverName" Title="Driver Name" />
                                    <PropertyColumn Property="x => x.StartDate" Title="Start Date" Format="dd/MM/yyyy" />
                                    <PropertyColumn Property="x => x.EndDate" Title="End Date" Format="dd/MM/yyyy" />
                                    <TemplateColumn Title="Status" Sortable="false" Filterable="false">
                                        <CellTemplate>
                                            @if (context.Item.IsActive)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default">Ended</MudChip>
                                            }
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="Actions" Sortable="false" Filterable="false">
                                        <CellTemplate>
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                           Color="Color.Primary"
                                                           OnClick="@(() => OpenEditAssignment(context.Item))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="@(() => ConfirmDeleteAssignmentAsync(context.Item))" />
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>
                        </MudItem>
                    </MudGrid>
                }
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
}

@code {
    private static readonly DialogOptions DialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    [Parameter]
    public int Id { get; set; }

    private VehicleReadDto? _vehicle;
    private bool _notFound;
    private IReadOnlyList<VehicleComponentReadDto> _components = [];
    private IReadOnlyList<DriverAssignmentReadDto> _assignments = [];
    private bool _loadingComponents;
    private bool _loadingAssignments;

    protected override async Task OnParametersSetAsync()
    {
        _vehicle = await VehicleService.GetVehicleByIdAsync(Id);
        _notFound = _vehicle is null;
        if (_vehicle is not null)
        {
            await ReloadComponentsAsync();
            await ReloadAssignmentsAsync();
        }
    }

    private async Task ReloadComponentsAsync()
    {
        _loadingComponents = true;
        try
        {
            _components = await ComponentService.GetComponentsAsync(Id);
        }
        finally
        {
            _loadingComponents = false;
        }
    }

    private async Task ReloadAssignmentsAsync()
    {
        _loadingAssignments = true;
        try
        {
            _assignments = await AssignmentService.GetAssignmentsAsync(Id);
        }
        finally
        {
            _loadingAssignments = false;
        }
    }

    private async Task ExportAssignmentsCsvAsync()
    {
        var csv = CsvExporter.Assignments(_assignments);
        var plate = _vehicle?.Plate.Replace(' ', '_') ?? Id.ToString();
        await JS.InvokeVoidAsync("downloadTextFile", $"assignments-{plate}-{DateTime.Today:yyyyMMdd}.csv", csv, "text/csv;charset=utf-8;");
        Snackbar.Add("Assignments exported.", Severity.Success);
    }

    private async Task EndActiveAssignmentAsync()
    {
        var confirm = await DialogService.ShowMessageBox(
            "End current assignment",
            "Set today's date as the end date for the active driver on this vehicle?",
            yesText: "End assignment",
            cancelText: "Cancel");

        if (confirm is not true)
            return;

        try
        {
            await AssignmentService.EndActiveAssignmentAsync(Id);
            Snackbar.Add("Active assignment ended.", Severity.Success);
            await ReloadAssignmentsAsync();
            _vehicle = await VehicleService.GetVehicleByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenCreateComponent()
    {
        var parameters = new DialogParameters<ComponentEditDialog>
        {
            { x => x.VehicleId, Id },
            { x => x.EditingId, null }
        };

        var dialog = await DialogService.ShowAsync<ComponentEditDialog>("Add Component", parameters, DialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Component created.", Severity.Success);
            await ReloadComponentsAsync();
        }
    }

    private async Task OpenEditComponent(VehicleComponentReadDto item)
    {
        try
        {
            var existing = await ComponentService.GetComponentForUpdateAsync(item.Id);
            var parameters = new DialogParameters<ComponentEditDialog>
            {
                { x => x.VehicleId, Id },
                { x => x.EditingId, item.Id },
                { x => x.InitialModel, existing }
            };

            var dialog = await DialogService.ShowAsync<ComponentEditDialog>("Edit Component", parameters, DialogOptions);
            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                Snackbar.Add("Component updated.", Severity.Success);
                await ReloadComponentsAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmDeleteComponentAsync(VehicleComponentReadDto item)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Delete Component",
            $"Delete component '{item.Name}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm is not true)
            return;

        try
        {
            await ComponentService.DeleteComponentAsync(item.Id);
            Snackbar.Add("Component deleted.", Severity.Success);
            await ReloadComponentsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenCreateAssignment()
    {
        var parameters = new DialogParameters<AssignmentEditDialog>
        {
            { x => x.VehicleId, Id },
            { x => x.EditingId, null }
        };

        var dialog = await DialogService.ShowAsync<AssignmentEditDialog>("Add Assignment", parameters, DialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Assignment created.", Severity.Success);
            await ReloadAssignmentsAsync();
            _vehicle = await VehicleService.GetVehicleByIdAsync(Id);
        }
    }

    private async Task OpenEditAssignment(DriverAssignmentReadDto item)
    {
        try
        {
            var existing = await AssignmentService.GetAssignmentForUpdateAsync(item.Id);
            var parameters = new DialogParameters<AssignmentEditDialog>
            {
                { x => x.VehicleId, Id },
                { x => x.EditingId, item.Id },
                { x => x.InitialModel, existing }
            };

            var dialog = await DialogService.ShowAsync<AssignmentEditDialog>("Edit Assignment", parameters, DialogOptions);
            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                Snackbar.Add("Assignment updated.", Severity.Success);
                await ReloadAssignmentsAsync();
                _vehicle = await VehicleService.GetVehicleByIdAsync(Id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmDeleteAssignmentAsync(DriverAssignmentReadDto item)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Delete Assignment",
            $"Delete assignment for '{item.DriverName}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm is not true)
            return;

        try
        {
            await AssignmentService.DeleteAssignmentAsync(item.Id);
            Snackbar.Add("Assignment deleted.", Severity.Success);
            await ReloadAssignmentsAsync();
            _vehicle = await VehicleService.GetVehicleByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
