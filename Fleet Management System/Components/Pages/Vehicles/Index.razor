@page "/vehicles"
@using Fleet_Management_System.Components.Dialogs
@using Fleet_Management_System.Components.Shared
@using Fleet_Management_System.Helpers
@inject IVehicleService VehicleService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Vehicles - Fleet Manager</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4">Vehicles</MudText>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsvAsync"
                   Disabled="_loading || !_filtered.Any()">
            Export CSV
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Add Vehicle
        </MudButton>
    </MudStack>
</MudStack>

<MudStack Row="true" Spacing="1" Class="mb-3" Wrap="Wrap.Wrap">
    <MudChip T="string" Size="Size.Small"
             Color="@(_filter == VehicleFilter.All ? Color.Primary : Color.Default)"
             Variant="@(_filter == VehicleFilter.All ? Variant.Filled : Variant.Outlined)"
             OnClick="@(() => SetFilter(VehicleFilter.All))">
        All (@_vehicles.Count)
    </MudChip>
    <MudChip T="string" Size="Size.Small"
             Color="@(_filter == VehicleFilter.ActiveDriver ? Color.Success : Color.Default)"
             Variant="@(_filter == VehicleFilter.ActiveDriver ? Variant.Filled : Variant.Outlined)"
             OnClick="@(() => SetFilter(VehicleFilter.ActiveDriver))">
        Active driver (@_vehicles.Count(v => v.HasActiveDriver))
    </MudChip>
    <MudChip T="string" Size="Size.Small"
             Color="@(_filter == VehicleFilter.Unassigned ? Color.Info : Color.Default)"
             Variant="@(_filter == VehicleFilter.Unassigned ? Variant.Filled : Variant.Outlined)"
             OnClick="@(() => SetFilter(VehicleFilter.Unassigned))">
        Unassigned (@_vehicles.Count(v => !v.HasActiveDriver))
    </MudChip>
    <MudChip T="string" Size="Size.Small"
             Color="@(_filter == VehicleFilter.InsuranceExpiring ? Color.Warning : Color.Default)"
             Variant="@(_filter == VehicleFilter.InsuranceExpiring ? Variant.Filled : Variant.Outlined)"
             OnClick="@(() => SetFilter(VehicleFilter.InsuranceExpiring))">
        Insurance expiring (@_vehicles.Count(v => v.IsInsuranceExpiringSoon))
    </MudChip>
</MudStack>

@if (!_loading && _vehicles.Count == 0)
{
    <MudPaper Elevation="1">
        <EmptyState Icon="@Icons.Material.Filled.DirectionsCar"
                    Title="No vehicles yet"
                    Message="Add your first vehicle to start managing the fleet."
                    ActionText="Add Vehicle"
                    OnAction="OpenCreateDialog" />
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Class="pa-2">
        <MudDataGrid T="VehicleReadDto" Items="_filtered" Dense="true" Hover="true" Loading="_loading"
                     Filterable="true" SortMode="SortMode.Multiple" RowsPerPage="10"
                     RowClick="OnRowClick" RowStyle="cursor: pointer;">
            <Columns>
                <PropertyColumn Property="x => x.Plate" Title="Plate" />
                <PropertyColumn Property="x => x.Brand" Title="Brand" />
                <PropertyColumn Property="x => x.Model" Title="Model" />
                <PropertyColumn Property="x => x.InsuranceExpiry" Title="Insurance Expiry"
                               Format="dd/MM/yyyy" />
                <TemplateColumn Title="Status" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1">
                            @if (context.Item.HasActiveDriver)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                                    Active driver
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                    Unassigned
                                </MudChip>
                            }
                            @if (context.Item.IsInsuranceExpiringSoon)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                                    Insurance expiring
                                </MudChip>
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false" Filterable="false" CellStyle="width: 140px;">
                    <CellTemplate>
                        <span @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => OpenEditDialog(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => ConfirmDeleteAsync(context.Item))" />
                        </span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="VehicleReadDto" />
            </PagerContent>
            <NoRecordsContent>
                <EmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                            Title="No vehicles match this filter"
                            Message="Try another quick filter or clear it to see the full list."
                            ActionText="Show all"
                            ActionIcon="@Icons.Material.Filled.Clear"
                            OnAction="@(() => SetFilter(VehicleFilter.All))" />
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private enum VehicleFilter { All, ActiveDriver, Unassigned, InsuranceExpiring }

    private static readonly DialogOptions DialogOptions = new()
    {
        CloseOnEscapeKey = true,
        MaxWidth = MaxWidth.Small,
        FullWidth = true
    };

    private IReadOnlyList<VehicleReadDto> _vehicles = [];
    private IEnumerable<VehicleReadDto> _filtered = [];
    private VehicleFilter _filter = VehicleFilter.All;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("filter", out var filterValue))
        {
            _filter = filterValue.ToString().ToLowerInvariant() switch
            {
                "active" => VehicleFilter.ActiveDriver,
                "unassigned" => VehicleFilter.Unassigned,
                "insurance" => VehicleFilter.InsuranceExpiring,
                _ => VehicleFilter.All
            };
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _vehicles = await VehicleService.GetVehiclesAsync();
            ApplyFilter();
        }
        finally
        {
            _loading = false;
        }
    }

    private Task SetFilter(VehicleFilter filter)
    {
        _filter = filter;
        ApplyFilter();
        return Task.CompletedTask;
    }

    private void ApplyFilter()
    {
        _filtered = _filter switch
        {
            VehicleFilter.ActiveDriver => _vehicles.Where(v => v.HasActiveDriver),
            VehicleFilter.Unassigned => _vehicles.Where(v => !v.HasActiveDriver),
            VehicleFilter.InsuranceExpiring => _vehicles.Where(v => v.IsInsuranceExpiringSoon),
            _ => _vehicles
        };
    }

    private void OnRowClick(DataGridRowClickEventArgs<VehicleReadDto> args) =>
        Navigation.NavigateTo($"/vehicles/{args.Item.Id}");

    private async Task ExportCsvAsync()
    {
        var csv = CsvExporter.Vehicles(_filtered);
        await JS.InvokeVoidAsync("downloadTextFile", $"vehicles-{DateTime.Today:yyyyMMdd}.csv", csv, "text/csv;charset=utf-8;");
        Snackbar.Add("Vehicles exported.", Severity.Success);
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<VehicleEditDialog>
        {
            { x => x.EditingId, null },
            { x => x.InitialModel, new VehicleWriteDto() }
        };

        var dialog = await DialogService.ShowAsync<VehicleEditDialog>("Add Vehicle", parameters, DialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Vehicle created.", Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task OpenEditDialog(VehicleReadDto vehicle)
    {
        try
        {
            var existing = await VehicleService.GetVehicleForUpdateAsync(vehicle.Id);
            var parameters = new DialogParameters<VehicleEditDialog>
            {
                { x => x.EditingId, vehicle.Id },
                { x => x.InitialModel, existing }
            };

            var dialog = await DialogService.ShowAsync<VehicleEditDialog>("Edit Vehicle", parameters, DialogOptions);
            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                Snackbar.Add("Vehicle updated.", Severity.Success);
                await ReloadAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmDeleteAsync(VehicleReadDto vehicle)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Delete Vehicle",
            $"Delete {vehicle.Brand} {vehicle.Model} ({vehicle.Plate})? This also removes related components and assignments.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm is not true)
            return;

        try
        {
            await VehicleService.DeleteVehicleAsync(vehicle.Id);
            Snackbar.Add("Vehicle deleted.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
